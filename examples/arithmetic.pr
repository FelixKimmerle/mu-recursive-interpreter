// Primitive recursive arithmetic, built on the library in prelude.pr.
// Run with:  mu-interp examples/arithmetic.pr

import "prelude.pr";

add(5, 7);
sub(12, 5);
sub(5, 12);         // modified subtraction never goes below 0
mult(6, 7);
pow(2, 10);
fact(6);
absdiff(3, 10);

leq(4, 5);
leq(5, 4);
eq(8, 8);
eq(8, 7);
and(3, 0);
or(3, 0);

cond(1, 5, 9);
cond(0, 5, 9);
max(9, 5);
min(9, 5);

div(17, 5);
mod(17, 5);
divides(3, 12);
divides(5, 12);

// Gauss: sum of 0..n-1 is n(n-1)/2
binom2(10);

// New functions are just more compositions. sum of squares 0^2+...+(n-1)^2:
square = mult(id, id);
sum_squares = rec(c(0, 0), add(pi(2, 1), square(pi(2, 2))));
sum_squares(4);     // 0 + 1 + 4 + 9

// Fibonacci via primitive recursion on pairs is possible but needs a pairing
// function, see examples/pairing.pr.
